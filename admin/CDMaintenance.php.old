/*
 ********************************************************************************
 * buildCDObject
 * 
 * This function loads builds a CD object from the data typed into the 
 * form fields.
 ********************************************************************************
*/
function buildCDObject($CD)
{

	//Load the Array used to populate the form fields based on the newly loaded object
	$CD->nCDID = $_POST['hdnCDID'];

	$CD->sCDName = html_entity_decode($_POST['txtCDName'], ENT_QUOTES);
	$CD->sCDShortName = html_entity_decode($_POST['txtCDShortName'], ENT_QUOTES);
	$CD->sCDDescription = html_entity_decode($_POST['txtCDDescription'], ENT_QUOTES);
	$CD->sCDImage = html_entity_decode($_POST['txtImage'], ENT_QUOTES);
	$CD->sCDThumbnail = html_entity_decode($_POST['txtThumbnail'], ENT_QUOTES);
	$CD->sUPC = html_entity_decode($_POST['txtUPC'], ENT_QUOTES);
	$CD->sRunTime = html_entity_decode($_POST['txtRunTime'], ENT_QUOTES);
	$CD->sPurchaseLink = html_entity_decode($_POST['txtPurchaseLink'], ENT_QUOTES);
	$CD->bFuzzyNameSearch = TRUE;
	$CD->nArtistID = $_POST['selArtist'];

	//Release Date	
	$dtReleaseDate = isset($_REQUEST["ReleaseDate"]) ? $_REQUEST["ReleaseDate"] : "";
	if($dtReleaseDate > "0000-00-00")
	{
		$CD->dtReleaseDate  	= $dtReleaseDate;
	}

}


/*
 ********************************************************************************
 * loadCD
 * 
 * This function loads the form field array from a populated CD object
 * so that it will be displayed in the form fields
 ********************************************************************************
*/
function loadCD(&$CD, $form)
{

	if (!is_null($CD->nCDID))
	{
		//Load Hidden Fields
		$_POST['hdnCDID'] = $CD->nCDID;

		$_POST['txtCDName'] = htmlentities($CD->sCDName, ENT_QUOTES);
		$_POST['txtCDShortName'] = htmlentities($CD->sCDShortName, ENT_QUOTES);
		$_POST['txtCDDescription'] = $CD->sCDDescription;
		$_POST['txtImage'] = htmlentities($CD->sCDImage, ENT_QUOTES);
		$_POST['txtThumbnail'] = htmlentities($CD->sCDThumbnail, ENT_QUOTES);
		$_POST['txtUPC'] = htmlentities($CD->sUPC, ENT_QUOTES);
		$_POST['txtRunTime'] = htmlentities($CD->sRunTime, ENT_QUOTES);
		$_POST['txtPurchaseLink'] = htmlentities($CD->sPurchaseLink, ENT_QUOTES);
		$_POST['txtLastUpdate'] = htmlentities($CD->dtLastUpdate, ENT_QUOTES);
		$_POST['ReleaseDate'] = htmlentities($CD->dtReleaseDate, ENT_QUOTES);
		$_POST['selArtist'] = $CD->nArtistID;
		
	}
	else
	{
		//Load Form field values into array 
		foreach($_POST as $fieldName=>$fieldValue) {
	
			$_POST[$fieldName]= htmlentities(stripslashes($fieldValue));
	
		}

	}

}


/*
 ********************************************************************************
 * clearFormFields
 * 
 * This function clears the form fields
 ********************************************************************************
*/
function clearFormFields($form)
{
	$_POST = array();
}

/*
 ********************************************************************************
 * copyFormFields
 * 
 * This function copies the data from the form back into the form field array
 ********************************************************************************
*/
function copyFormFields($form)
{

	//Load Form field values into array 
	foreach($_POST as $fieldName=>$fieldValue) 
	{
		$_POST[$fieldName]= htmlentities(stripslashes($fieldValue));
	}
}

