/*
 ********************************************************************************
 * buildSongObject
 * 
 * This function loads builds a Song object from the data typed into the 
 * form fields.
 ********************************************************************************
*/
function buildSongObject($Song)
{

	//Load the Array used to populate the form fields based on the newly loaded object
	$Song->nSongID = $_POST['hdnSongID'];

	$Song->sSongName = html_entity_decode($_POST['txtSongName'], ENT_QUOTES);
	$Song->sSongImage = html_entity_decode($_POST['txtImage'], ENT_QUOTES);
	$Song->nTrackNumber = html_entity_decode($_POST['txtTrackNumber'], ENT_QUOTES);
	$Song->nCDID = $_POST['selCD'];
	$Song->sLyricsHTML = html_entity_decode($_POST['txtLyricsHTML'], ENT_QUOTES);
	$Song->sRunTime = html_entity_decode($_POST['txtRunTime'], ENT_QUOTES);
	$Song->sISRC = html_entity_decode($_POST['txtISRC'], ENT_QUOTES);
	$Song->sCatalogNumber = html_entity_decode($_POST['txtCatalogNumber'], ENT_QUOTES);
	$Song->sUPC = html_entity_decode($_POST['txtUPC'], ENT_QUOTES);
	$Song->sSampleMP3 = html_entity_decode($_POST['txtSampleMP3'], ENT_QUOTES);
	$Song->nArtistID = $_POST['selArtist'];
	if (is_numeric($_POST['txtBMINumber']))
	{
		$Song->nBMINumber = html_entity_decode($_POST['txtBMINumber'], ENT_QUOTES);
	}
	else
	{
		$Song->nBMINumber = 0;
	}

	if($_POST['chkActive'] == "ACTIVE")
	{
		$Song->bActive = TRUE;
	}

	//Release Date	
	$dtReleaseDate = isset($_REQUEST["ReleaseDate"]) ? $_REQUEST["ReleaseDate"] : "";
	if($dtReleaseDate > "0000-00-00")
	{
		$Song->dtReleaseDate  	= $dtReleaseDate;
	}
	
	
	$Song->bFuzzyNameSearch = TRUE;

}


/*
 ********************************************************************************
 * loadSong
 * 
 * This function loads the form field array from a populated Song object
 * so that it will be displayed in the form fields
 ********************************************************************************
*/
function loadSong(&$Song, $form)
{

	if (!is_null($Song->nSongID))
	{
		//Load Hidden Fields
		$_POST['hdnSongID'] = $Song->nSongID;

		$_POST['selCD'] = $Song->nCDID;
		$_POST['txtSongName'] = htmlentities($Song->sSongName, ENT_QUOTES);
		$_POST['txtTrackNumber'] = htmlentities($Song->nTrackNumber, ENT_QUOTES);
		$_POST['txtImage'] = htmlentities($Song->sSongImage, ENT_QUOTES);
		$_POST['txtLyricsHTML'] = htmlentities($Song->sLyricsHTML, ENT_QUOTES);
		$_POST['txtSampleMP3'] = htmlentities($Song->sSampleMP3, ENT_QUOTES);
		$_POST['ReleaseDate'] = htmlentities($Song->dtReleaseDate, ENT_QUOTES);
		$_POST['txtRunTime'] = htmlentities($Song->sRunTime, ENT_QUOTES);
		$_POST['txtISRC'] = htmlentities($Song->sISRC, ENT_QUOTES);
		$_POST['txtCatalogNumber'] = htmlentities($Song->sCatalogNumber, ENT_QUOTES);
		$_POST['txtUPC'] = htmlentities($Song->sUPC, ENT_QUOTES);
		$_POST['txtLastUpdate'] = htmlentities($Song->dtLastUpdate, ENT_QUOTES);
		$_POST['selArtist'] = $Song->nArtistID;
		$_POST['txtBMINumber'] = htmlentities($Song->nBMINumber, ENT_QUOTES);
		$_POST['chkActive'] = $Song->bActive;

		
	}
	else
	{
		//Load Form field values into array 
		foreach($_POST as $fieldName=>$fieldValue) {
	
			$_POST[$fieldName]= htmlentities(stripslashes($fieldValue));
	
		}

	}

}


/*
 ********************************************************************************
 * clearFormFields
 * 
 * This function clears the form fields
 ********************************************************************************
*/
function clearFormFields($form)
{
	$_POST = array();
	
}

/*
 ********************************************************************************
 * copyFormFields
 * 
 * This function copies the data from the form back into the form field array
 ********************************************************************************
*/
function copyFormFields($form)
{

	//Load Form field values into array 
	foreach($_POST as $fieldName=>$fieldValue) 
	{
		$_POST[$fieldName]= htmlentities(stripslashes($fieldValue));
	}
}

