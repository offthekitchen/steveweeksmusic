    {
        sErrorMessage += "Performance Name Required\n";
        bValid = false;
    }

	//Performance Name is a required Field
    if ( document.PerformanceMaint.PerformanceDate.value == "" || document.PerformanceMaint.PerformanceDate.value == "0000-00-00" )
