			$i = 1;
		
			echo "	<TD class='" , $sResultStyleClass . "'>" . $oCategoryRecord->sCategoryName . "</TD>";
			echo "</TR>";
		}
		?>
	
	</table>	
		
	<?php
	}
	else
	{
	?>
	
