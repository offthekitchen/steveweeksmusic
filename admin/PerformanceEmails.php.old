/*
 ********************************************************************************
 * buildPerformanceObject
 * 
 * This function loads builds a flag object from the data typed into the 
 * form fields.
 ********************************************************************************
*/
function buildPerformanceObject($oPerformance)
{

	//Load the Array used to populate the form fields based on the newly loaded object
	$oPerformance->nPerformanceID = $_POST['hdnPerformanceID'];

	$oPerformance->sPerformanceName = html_entity_decode($_POST['txtPerformanceName'], ENT_QUOTES);
	$oPerformance->bFuzzyNameSearch = TRUE;
	$oPerformance->sPerformanceWebsite = html_entity_decode($_POST['txtPerformanceWebsite'], ENT_QUOTES);
	$oPerformance->sPerformanceTime = html_entity_decode($_POST['txtPerformanceTime'], ENT_QUOTES);
	$oPerformance->sLocation = html_entity_decode($_POST['txtLocation'], ENT_QUOTES);
	$oPerformance->sLocationWebsite = html_entity_decode($_POST['txtLocationWebsite'], ENT_QUOTES);
	$oPerformance->sLocationAddr1 = html_entity_decode($_POST['txtLocationAddr1'], ENT_QUOTES);
	$oPerformance->sLocationAddr2 = html_entity_decode($_POST['txtLocationAddr2'], ENT_QUOTES);
	$oPerformance->sLocationCity = html_entity_decode($_POST['txtLocationCity'], ENT_QUOTES);
	$oPerformance->sLocationState = html_entity_decode($_POST['txtLocationState'], ENT_QUOTES);
	$oPerformance->sLocationZip = html_entity_decode($_POST['txtLocationZip'], ENT_QUOTES);
	$oPerformance->sDescription = html_entity_decode($_POST['txtDescription'], ENT_QUOTES);
	$oPerformance->sAdmission = html_entity_decode($_POST['txtAdmission'], ENT_QUOTES);
	$oPerformance->sContactName = html_entity_decode($_POST['txtContactName'], ENT_QUOTES);
	$oPerformance->sContactEmail = html_entity_decode($_POST['txtContactEmail'], ENT_QUOTES);
	$oPerformance->sContactPhone = html_entity_decode($_POST['txtContactPhone'], ENT_QUOTES);
	$oPerformance->sVenuePhone = html_entity_decode($_POST['txtVenuePhone'], ENT_QUOTES);
	$oPerformance->sPhotoAlbum = html_entity_decode($_POST['txtPhotoAlbum'], ENT_QUOTES);
	$oPerformance->sVideoURL = html_entity_decode($_POST['txtVideoURL'], ENT_QUOTES);
	$oPerformance->sNotes = html_entity_decode($_POST['txtNotes'], ENT_QUOTES);
	$oPerformance->sAirfare = $_POST['selAirfare'];
	$oPerformance->sHotel = $_POST['selHotel'];
	$oPerformance->sRentalCar = $_POST['selRentalCar'];

	$oPerformance->nBookedAmount = html_entity_decode($_POST['txtBookedAmount'], ENT_QUOTES);

	//Performance Date	
	$dtPerformanceDate = isset($_REQUEST["PerformanceDate"]) ? $_REQUEST["PerformanceDate"] : "";
	if($dtPerformanceDate > "0000-00-00")
	{
		$oPerformance->dtPerformanceDate  = $dtPerformanceDate;
	}

	//Booked Date	
	$dtBookedDate = isset($_REQUEST["BookedDate"]) ? $_REQUEST["BookedDate"] : "";
	if($dtBookedDate > "0000-00-00")
	{
		$oPerformance->dtBookedDate  = $dtBookedDate;
	}
	
	//Load Contract Boolean only if checked (don't search for this field if not checked)
	if(isset($_POST['chkContract']) && $_POST['chkContract'] == 'contract')  
	{  
		$oPerformance->bContract = TRUE;
	}
	//If we are searching and the Contract checkbox isn't checked, don't use it in the search
	else if (!isset($_POST["btnSearch"]))
	{
		$oPerformance->bContract = FALSE;
	}

}


/*
 ********************************************************************************
 * loadPerformance
 * 
 * This function loads the form field array from a populated Performance object
 * so that it will be displayed in the form fields
 ********************************************************************************
*/
function loadPerformance(&$oPerformance, $form)
{

	if (!is_null($oPerformance->nPerformanceID))
	{
		//Load Hidden Fields
		$form->aFormFieldValues['hdnPerformanceID'] = $oPerformance->nPerformanceID;
		

		$form->aFormFieldValues['txtPerformanceName'] = htmlentities($oPerformance->sPerformanceName, ENT_QUOTES);
		$form->aFormFieldValues['txtPerformanceWebsite'] = htmlentities($oPerformance->sPerformanceWebsite, ENT_QUOTES);
		$form->aFormFieldValues['PerformanceDate'] = htmlentities($oPerformance->dtPerformanceDate, ENT_QUOTES);
		$form->aFormFieldValues['txtPerformanceTime'] = htmlentities($oPerformance->sPerformanceTime, ENT_QUOTES);
		$form->aFormFieldValues['txtLocation'] = htmlentities($oPerformance->sLocation, ENT_QUOTES);
		$form->aFormFieldValues['txtLocationWebsite'] = htmlentities($oPerformance->sLocationWebsite, ENT_QUOTES);
		$form->aFormFieldValues['txtLocationAddr1'] = htmlentities($oPerformance->sLocationAddr1, ENT_QUOTES);
		$form->aFormFieldValues['txtLocationAddr2'] = htmlentities($oPerformance->sLocationAddr2, ENT_QUOTES);
		$form->aFormFieldValues['txtLocationCity'] = htmlentities($oPerformance->sLocationCity, ENT_QUOTES);
		$form->aFormFieldValues['txtLocationState'] = htmlentities($oPerformance->sLocationState, ENT_QUOTES);
		$form->aFormFieldValues['txtLocationZip'] = htmlentities($oPerformance->sLocationZip, ENT_QUOTES);
		$form->aFormFieldValues['txtDescription'] = htmlentities($oPerformance->sDescription, ENT_QUOTES);
		$form->aFormFieldValues['txtAdmission'] = htmlentities($oPerformance->sAdmission, ENT_QUOTES);
		$form->aFormFieldValues['txtContactName'] = htmlentities($oPerformance->sContactName, ENT_QUOTES);
		$form->aFormFieldValues['txtContactEmail'] = htmlentities($oPerformance->sContactEmail, ENT_QUOTES);
		$form->aFormFieldValues['txtContactPhone'] = htmlentities($oPerformance->sContactPhone, ENT_QUOTES);
		$form->aFormFieldValues['txtVenuePhone'] = htmlentities($oPerformance->sVenuePhone, ENT_QUOTES);
		$form->aFormFieldValues['txtPhotoAlbum'] = htmlentities($oPerformance->sPhotoAlbum, ENT_QUOTES);
		$form->aFormFieldValues['txtVideoURL'] = htmlentities($oPerformance->sVideoURL, ENT_QUOTES);
		$form->aFormFieldValues['txtBookedAmount'] = htmlentities($oPerformance->nBookedAmount, ENT_QUOTES);
		$form->aFormFieldValues['BookedDate'] = htmlentities($oPerformance->dtBookedDate, ENT_QUOTES);
		$form->aFormFieldValues['txtNotes'] = htmlentities($oPerformance->sNotes, ENT_QUOTES);
		$form->aFormFieldValues['selAirfare'] = htmlentities($oPerformance->sAirfare, ENT_QUOTES);
		$form->aFormFieldValues['selHotel'] = htmlentities($oPerformance->sHotel, ENT_QUOTES);
		$form->aFormFieldValues['selRentalCar'] = htmlentities($oPerformance->sRentalCar, ENT_QUOTES);
		$form->aFormFieldValues['txtLastUpdate'] = htmlentities($oPerformance->dtLastUpdate, ENT_QUOTES);
		
		if($oPerformance->bContract)
		{
			$form->aFormFieldValues['chkContract'] = TRUE;
		}
		else
		{
			$form->aFormFieldValues['chkContract'] = FALSE;
		}
		
		
		
	}
	else
	{
		//Load Form field values into array 
		foreach($_POST as $fieldName=>$fieldValue) {
	
			//$form->aFormFieldValues[$fieldName]= htmlentities(stripslashes($fieldValue));
			$form->aFormFieldValues[$fieldName]= $fieldValue;
	
		}
		

	}

}


/*
 ********************************************************************************
 * clearFormFields
 * 
 * This function clears the form fields
 ********************************************************************************
*/
function clearFormFields($form)
{

	//Hidden Fileds must be set to 0
	$form->aFormFieldValues = array();
	$form->aFormFieldValues['hdnPerformanceID'] = 0;


}

/*
 ********************************************************************************
 * copyFormFields
 * 
 * This function copies the data from the form back into the form field array
 ********************************************************************************
*/
function copyFormFields($form)
{

	//Load Form field values into array 
	foreach($_POST as $fieldName=>$fieldValue) 
	{
		$form->aFormFieldValues[$fieldName]= htmlentities(stripslashes($fieldValue));
	}
}

