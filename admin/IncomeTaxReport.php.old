										echo "<a href='" . ADMIN_DIR . "/RevenueMaintenance.php?START_DATE=" . $_POST['StartDate'];
										echo "&END_DATE=" . $_POST['EndDate'] . "'>";
										echo number_format((float)$nTotalRevenueAmount, 2, '.', '');
