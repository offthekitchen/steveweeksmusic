/*
 ********************************************************************************
 * buildSongData()
 * 
 * This function builds a table pf Song Data
 ********************************************************************************
*/
function buildSongData(&$oSong)
{

	if ($oSong->nCDID > 0)
	{
		$oCD = new CD();
		$oCD->nCDID = $oSong->nCDID;
		if ($oCD->getCD())
		{
			$sCDName = $oCD->aCDRecords[0]->sCDName;
			
			if (empty($oSong->sUPC))
			{
				$sUPC = $oCD->aCDRecords[0]->sUPC; 
			}
			else
			{
				$sUPC = $oSong->sUPC; 
			}
			
		} 
		else
		{
			//ERROR RETRIEVING CD
		}
	}
	else
	{
		$sUPC = $oSong->sUPC; 
	}

	echo "<div class='SongInfo'>";
	echo "<dl>";
	echo "<div>";
	echo "<dt>Song Name:</dt>";
	echo "<dd>{$oSong->sSongName}</dd>";
	echo "</div>";

	echo "<div>";
	echo "<dt>CD</dt>";
	echo "<dd>{$oCD->aCDRecords[0]->sCDName}</dd>";
	echo "</div>";

	echo "<div>";
	echo "<dt>UPC</dt>";
	echo "<dd>{$sUPC}</dd>";
	echo "</div>";

	echo "<div>";
	echo "<dt>Run Time</dt>";
	echo "<dd>{$oSong->sRunTime}</dd>";
	echo "</div>";
	
	echo "<div>";
	echo "<dt>ISRC</dt>";
	echo "<dd>{$oSong->sISRC}</dd>";
	echo "</div>";

	echo "<div>";
	echo "<dt>Catalog #</dt>";
	echo "<dd>{$oSong->sCatalogNumber}</dd>";
	echo "</div>";

	echo "</dl>";
	echo "</div>";
}
?>